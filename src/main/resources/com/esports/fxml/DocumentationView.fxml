                    <!-- ETAPE 1 : CAPTURE -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 1 — Capture des intervalles de frappe  (TypingProfiler)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="TypingProfiler s'attache au PasswordField dans initialize(). Il écoute chaque touche tapée (KEY_TYPED) et enregistre le timestamp System.currentTimeMillis(). getIntervals() calcule les écarts entre touches et les normalise par la moyenne — ainsi un utilisateur rapide et un lent ont le même vecteur, seul le rythme compte."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// TypingProfiler.java" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="public void attach(PasswordField field) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    field.addEventFilter(KeyEvent.KEY_TYPED, e -&gt; {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        if (ch == null || ch.isEmpty() || ch.charAt(0) &lt; 32) return;" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        timestamps.add(System.currentTimeMillis()); // horodatage" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    });" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="public List&lt;Double&gt; getIntervals() {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    // Calcul des écarts bruts entre chaque touche" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    double gap = timestamps.get(i) - timestamps.get(i-1);" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    if (gap &lt; 2000) raw.add(gap); // ignore les pauses &gt; 2s" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="    // Normalisation : divise par la moyenne → rythme indépendant de la vitesse" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    double mean = raw.stream().mapToDouble(d -&gt; d).average().orElse(1);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    for (double v : raw) norm.add(v / mean); // vecteur normalisé" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    return norm;" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 2 : COMPARAISON -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 2 — Comparaison MAE + apprentissage adaptatif  (TypingBiometricService)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="compare() calcule le MAE (Mean Absolute Error) entre le profil stocké et les intervalles capturés. Si MAE &lt; 0.35 → MATCH. updateProfile() met à jour le profil avec un rolling average pondéré : 80% ancien profil + 20% nouvelle capture pour rester stable tout en s'adaptant."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// TypingBiometricService.java" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// COMPARAISON — alignedMAE entre profil stocké et capture" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="private static double alignedMAE(List&lt;Double&gt; a, List&lt;Double&gt; b) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    int len = Math.min(a.size(), b.size());" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    double sum = 0;" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    for (int i = 0; i &lt; len; i++) sum += Math.abs(a.get(i) - b.get(i));" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    return sum / len; // résultat : proche de 0 = même rythme" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// compare() retourne l'enum : NO_PROFILE / TOO_SHORT / MATCH / MISMATCH" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="double mae = alignedMAE(stored, captured);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="return mae &lt; 0.35 ? Result.MATCH : Result.MISMATCH;" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// APPRENTISSAGE ADAPTATIF — rolling average 80/20" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="merged.add(stored.get(i) * 0.80 + captured.get(i) * 0.20);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="// → profil très stable, s'adapte légèrement à chaque connexion" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 3 : INTEGRATION LOGIN -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 3 — Intégration dans le flux de connexion  (LoginController)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="La vérification n'a lieu QUE si l'utilisateur a activé la protection (isEnabled). Sur MISMATCH, logout immédiat. Sur NO_PROFILE, on sauvegarde le premier profil. Sur MATCH, on met à jour avec rolling average."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// LoginController.java — après connexion réussie" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="int uid = AuthService.getCurrentUser().getId();" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (TypingBiometricService.isEnabled(uid)) { // opt-in seulement" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="    Result bio = TypingBiometricService.compare(uid, typingIntervals);" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="    if (bio == MISMATCH) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        AuthService.logout();         // accès refusé" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        lblError.setText(&quot;✗ Rythme de frappe non reconnu.&quot;);" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        return;" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    }" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    if (bio == NO_PROFILE)  saveProfile(uid, typingIntervals);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    if (bio == MATCH)       updateProfile(uid, typingIntervals);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- BDD -->
                    <VBox spacing="6">
                        <Label text="BASE DE DONNÉES" style="-fx-text-fill: #7c3aed; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 12 18 12 18;">
                            <Label text="user.typing_profile           TEXT     NULL  -- ex: '0.95,1.20,0.88,1.05;5'" style="-fx-text-fill: #a78bfa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="                                               --     intervalles;nb_samples" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="user.typing_biometric_enabled TINYINT  DEFAULT 0  -- 0=désactivé, 1=actif" style="-fx-text-fill: #a78bfa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  3. GAMERTAG CREATOR                                        -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: rgba(20,14,50,0.95); -fx-border-color: rgba(168,85,247,0.4);
                                     -fx-border-width: 1.5; -fx-border-radius: 14; -fx-background-radius: 14;">
                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-background-color: linear-gradient(to right,rgba(124,58,237,0.55),rgba(124,58,237,0.05));
                             -fx-padding: 18 28 18 28; -fx-background-radius: 14 14 0 0;">
                    <Label text="🎮" style="-fx-font-size: 24px;"/>
                    <VBox spacing="3">
                        <Label text="3.  GAMERTAG CREATOR — Générateur de Pseudos IA"
                               style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <Label text="Fichiers :  GamertagAiService.java  ·  GamertagGeneratorDialog.java  ·  ProfileController.java"
                               style="-fx-text-fill: #a78bfa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </VBox>
                </HBox>

                <VBox spacing="28" style="-fx-padding: 28 32 32 32;">

                    <!-- ETAPE 1 : BANQUES DE MOTS -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 1 — Banques de mots par jeu  (GAME_WORDS)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="GamertagAiService contient une Map statique de 15+ jeux, chacun avec 16–24 mots liés à l'univers du jeu. resolveWordBank() cherche d'abord un match exact sur le nom nettoyé, puis un match partiel. Si aucun jeu n'est trouvé, DEFAULT_WORDS est utilisé."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// GamertagAiService.java — GAME_WORDS (extrait)" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="GAME_WORDS.put(&quot;valorant&quot;, new String[]{" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    &quot;Phantom&quot;,&quot;Vandal&quot;,&quot;Jett&quot;,&quot;Reyna&quot;,&quot;Spike&quot;,&quot;Ace&quot;,&quot;Clutch&quot;,..." style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="});" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// STYLE_PREFIX — 6 styles avec préfixes différents" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="STYLE_PREFIX.put(&quot;agressif&quot;,   {&quot;xX&quot;,&quot;Dark&quot;,&quot;Rage&quot;,&quot;Savage&quot;,&quot;Blood&quot;,...});" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="STYLE_PREFIX.put(&quot;mysterieux&quot;, {&quot;Void&quot;,&quot;Shadow&quot;,&quot;Phantom&quot;,&quot;Ghost&quot;,...});" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="STYLE_PREFIX.put(&quot;legendaire&quot;, {&quot;Pro&quot;,&quot;Elite&quot;,&quot;God&quot;,&quot;King&quot;,&quot;Omega&quot;,...});" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// resolveWordBank() — matching jeu" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="String key = game.toLowerCase().replaceAll(&quot;[^a-z0-9]&quot;, &quot;&quot;);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (GAME_WORDS.containsKey(key)) return GAME_WORDS.get(key); // exact" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="// sinon : partial match (ex: 'league of legends' trouve 'lol')" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 2 : GENERATION -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 2 — Génération des 6 tags  (generate + buildTag)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="generate() boucle jusqu'à avoir 6 tags uniques (max 80 tentatives). buildTag() choisit aléatoirement parmi 4 stratégies d'assemblage et a 30% de chance d'intégrer le mot-clé utilisateur. Le résultat est clampé à 3–16 caractères alphanumériques."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// GamertagAiService.java — buildTag()" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="String word   = pick(rng, wordBank);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="String prefix = pick(rng, prefixes);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="String suffix = pick(rng, suffixes);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 30% de chance d'utiliser le mot-clé de l'utilisateur" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (keyword != null &amp;&amp; rng.nextInt(10) &lt; 3)" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    word = capitalise(keyword.replaceAll(&quot;[^a-zA-Z0-9]&quot;, &quot;&quot;));" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 4 stratégies d'assemblage choisies aléatoirement" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="switch (rng.nextInt(4)) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    case 0 -&gt; tag = prefix + word + suffix;  // DarkPhantomGG" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    case 1 -&gt; tag = word + suffix;           // PhantomGG" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    case 2 -&gt; tag = prefix + word;           // DarkPhantom" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    default -&gt; tag = keyword + word;         // LiwaPhantom" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="tag = tag.replaceAll(&quot;[^a-zA-Z0-9_]&quot;, &quot;&quot;);  // nettoie" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (tag.length() &gt; 16) tag = tag.substring(0, 16); // clamp" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 3 : UI -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 3 — Interface utilisateur  (GamertagGeneratorDialog)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="La dialog est entièrement construite en Java (pas de FXML). Elle affiche un champ jeu, une ComboBox style (6 options), un champ mot-clé optionnel, un bouton Générer, et les 6 résultats sous forme de chips cliquables. Un clic sur un chip copie le tag dans le presse-papier automatiquement."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// GamertagGeneratorDialog.java — onGenerate() et chips" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// Appel du service pour générer 6 tags" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="List&lt;String&gt; tags = GamertagAiService.generate(game, style, keyword);" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// Chaque tag devient un bouton chip cliquable" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="for (String tag : tags) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    Button chip = new Button(tag);" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    chip.setOnAction(e -&gt; {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        Clipboard.getSystemClipboard().setContent(content);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        chip.setText(tag + &quot; ✓ Copié !&quot;); // feedback visuel" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    });" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <Label text="BASE DE DONNÉES  →  Aucune. Service entièrement sans état."
