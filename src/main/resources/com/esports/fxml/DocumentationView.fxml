                            <Label text="    }" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="});" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
