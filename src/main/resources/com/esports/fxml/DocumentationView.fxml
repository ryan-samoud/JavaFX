                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  4. CAPTCHA                                                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: rgba(20,14,50,0.95); -fx-border-color: rgba(168,85,247,0.4);
                                     -fx-border-width: 1.5; -fx-border-radius: 14; -fx-background-radius: 14;">
                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-background-color: linear-gradient(to right,rgba(124,58,237,0.55),rgba(124,58,237,0.05));
                             -fx-padding: 18 28 18 28; -fx-background-radius: 14 14 0 0;">
                    <Label text="🔒" style="-fx-font-size: 24px;"/>
                    <VBox spacing="3">
                        <Label text="4.  CAPTCHA — Puzzle Coulissant Style Genshin"
                               style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <Label text="Fichiers :  CaptchaDialog.java  (entier en Java, sans FXML)  ·  LoginController.java"
                               style="-fx-text-fill: #a78bfa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </VBox>
                </HBox>

                <VBox spacing="28" style="-fx-padding: 28 32 32 32;">

                    <!-- FLUX -->
                    <VBox spacing="8">
                        <Label text="FLUX GLOBAL" style="-fx-text-fill: #7c3aed; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="Appelé dans LoginController.onLogin() AVANT l'authentification. La dialog est modale et non-décorée. Elle génère un puzzle, affiche l'image, laisse l'utilisateur glisser la pièce, vérifie la position ±10px. Faux → spring-back animation. Après 5 échecs, doit rafraîchir. Vrai → fermeture après 750ms et retour true au contrôleur."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- ETAPE 1 : GÉNÉRATION DU PUZZLE -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 1 — Génération du puzzle  (generatePuzzle)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="generatePuzzle() choisit une position cible X aléatoire entre 80 et 240px. Elle charge une image depuis les ressources (/com/esports/captcha/1-20.jpg), puis extrait un WritableImage de 60×60px à la position cible — c'est la pièce qui sera glissée."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// CaptchaDialog.java — generatePuzzle()" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="int minX = PIECE_W + 20;           // = 80px min" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="int maxX = IMG_W - PIECE_W - 20;   // = 240px max" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="targetX = minX + random.nextInt(maxX - minX); // position secrète" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="sourceImage = loadImage();   // charge image ou génère fond procédural" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="PixelReader pr = sourceImage.getPixelReader();" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// Extrait la pièce 60×60 à la position cible" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="pieceImage = new WritableImage(pr, targetX, PIECE_Y, PIECE_W, PIECE_H);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 2 : DESSIN CANVAS -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 2 — Rendu du canvas  (drawPuzzle)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="drawPuzzle() redessine tout le canvas à chaque déplacement du handle. Elle superpose : image de fond complète, un trou sombre à la position cible, la pièce glissante avec un clip arrondi (rrClip). En cas de succès, un glow ring vert s'affiche autour du trou."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// CaptchaDialog.java — drawPuzzle(boolean success)" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 1. Image de fond complète" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.drawImage(sourceImage, 0, 0, IMG_W, IMG_H);" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 2. Trou sombre à la position cible" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.setFill(Color.web(&quot;rgba(0,0,0,0.62)&quot;));" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.fillRoundRect(targetX, PIECE_Y, PIECE_W, PIECE_H, 10, 10);" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 3. Pièce glissante avec clip arrondi (rrClip = arcTo)" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.save();" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="rrClip(gc, dragX, PIECE_Y, PIECE_W, PIECE_H, 10); // clip arrondi" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.drawImage(pieceImage, dragX, PIECE_Y, PIECE_W, PIECE_H);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="gc.restore();" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// 4. Glow ring vert si succès" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (success) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    gc.setStroke(Color.web(&quot;rgba(74,222,128,0.35)&quot;));" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    gc.strokeRoundRect(targetX-3, PIECE_Y-3, PIECE_W+6, PIECE_H+6, 13,13);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 3 : VÉRIFICATION -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 3 — Vérification et animations  (verify)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="verify() compare dragX à targetX avec une tolérance de ±10px. En cas de succès, result=true, animation verte et fermeture après 750ms. En cas d'échec, une Timeline anime le retour du handle vers la gauche (spring-back) en 350ms avec EASE_OUT."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// CaptchaDialog.java — verify()" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="double diff = Math.abs(dragX - targetX); // écart pièce / cible" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="if (diff &lt;= TOLERANCE) { // TOLERANCE = ±10px → SUCCÈS" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    result = true;  locked = true;" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    lblStatus.setText(&quot;✔ Vérification réussie !&quot;);" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    drawPuzzle(true); // glow vert" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    new PauseTransition(750ms).setOnFinished(e -&gt; stage.close());" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="} else {                  // ÉCHEC — spring-back animation" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    attempts++;" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    // Timeline 350ms ramène le handle à gauche (EASE_OUT)" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    new Timeline(new KeyFrame(Duration.millis(350)," style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        new KeyValue(handlePane.layoutXProperty(), 2.0, EASE_OUT)" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    )).play();" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- ETAPE 4 : IMAGE FALLBACK -->
                    <VBox spacing="10">
                        <Label text="ÉTAPE 4 — Chargement image + fallback procédural  (loadImage)"
                               style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label wrapText="true"
                               text="loadImage() mélange aléatoirement une liste de 60 candidats (1–20 × .jpg/.jpeg/.png) et essaie chaque chemin dans les ressources. Si aucune image n'est trouvée, generateProceduralImage() produit un fond purple/teal avec bruit sinusoïdal — aucune dépendance externe."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 14 18 14 18;">
                            <Label text="// CaptchaDialog.java — generateProceduralImage() (fallback)" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="for (int y = 0; y &lt; IMG_H; y++) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    for (int x = 0; x &lt; IMG_W; x++) {" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        double v1 = Math.sin((x+seed)*0.09) * Math.cos((y+seed)*0.13) * 0.15;" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        double r  = clamp(0.05 + 0.30*nx + v1 + ...); // canal rouge" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        double b  = clamp(0.13 + 0.32*(1-ny) + v1 + ...); // bleu" style="-fx-text-fill: #60a5fa; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="        pw.setColor(x, y, Color.color(r, g, b));" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    }" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- Integration -->
                    <VBox spacing="6">
                        <Label text="INTÉGRATION DANS LOGIN" style="-fx-text-fill: #7c3aed; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <VBox spacing="2" style="-fx-background-color: #0d0b1e; -fx-border-color: rgba(168,85,247,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 12 18 12 18;">
                            <Label text="// LoginController.java — onLogin()" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text=" " style="-fx-font-size: 4px;"/>
                            <Label text="// CAPTCHA obligatoire AVANT l'appel au service d'auth" style="-fx-text-fill: #6b7280; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="if (!CaptchaDialog.show(btnLogin.getScene().getWindow())) {" style="-fx-text-fill: #fb923c; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    lblError.setText(&quot;⚠ Vérification de sécurité requise.&quot;);" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="    return;  // bloque la connexion si CAPTCHA échoué" style="-fx-text-fill: #f87171; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="}" style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                            <Label text="// Si ici → CAPTCHA validé, on continue vers authService.login()" style="-fx-text-fill: #4ade80; -fx-font-family: 'Courier New'; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <Label text="BASE DE DONNÉES  →  Aucune. Tout en mémoire, sans état persistant."
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>

            <!-- FOOTER -->
            <Label alignment="CENTER" text="NexUS Esports — Documentation interne  ·  2026  ·  À supprimer avant livraison"
                   style="-fx-text-fill: #374151; -fx-font-size: 12px;"/>

        </VBox>
    </VBox>
</ScrollPane>
